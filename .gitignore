# Only generated, dependency, secret, and local-machine files belong here.
# Source code, public assets, resume PDFs, and package-lock.json stay tracked.

# Dependencies
node_modules/

# Production build output (generated by `npm run build`)
dist/
dist-ssr/

# Local environment variables / secrets
.env
.env.*
!.env.example

# Local tooling caches
*.local
*.tsbuildinfo

# Logs
*.log

# Deployment CLI metadata
.vercel/
.netlify/

# OS noise
.DS_Store
Thumbs.db
